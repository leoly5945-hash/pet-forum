# Pet Forum — production environment template (copy to .env on server; never commit secrets)

# ── WordPress / MySQL ──
WORDPRESS_PORT=8080
PHPMYADMIN_PORT=8081
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
MYSQL_DATABASE=petforum
MYSQL_USER=petforum_user
MYSQL_PASSWORD=CHANGE_ME_STRONG_PASSWORD
WORDPRESS_TABLE_PREFIX=pet70_
WORDPRESS_DEBUG=0

# ── AI chatbot ──
PF_AI_MODE=n8n
PF_N8N_WEBHOOK=https://n8n.petforum.vn/webhook/pet-bot
# Or Dify:
# PF_AI_MODE=dify
# PF_DIFY_API_URL=https://api.dify.ai/v1
# PF_DIFY_APP_TOKEN=app-XXXXXXXX

# ── Security (also set in deploy/wp-config-extra.php) ──
PF_HIDE_DEFAULT_LOGIN=true
PF_LOGIN_SLUG=dang-nhap-pet

# ── Cloudflare Turnstile ──
# PF_TURNSTILE_SITE_KEY=0x4AAAA...
# PF_TURNSTILE_SECRET_KEY=0x4AAAA...

# ── AdSense (optional — or set in WP Admin → PetForum → Ads) ──
# ADSENSE_CLIENT=ca-pub-XXXXXXXXXX
# ADSENSE_SLOT_HEADER=XXXXXXXXXX
# ADSENSE_SLOT_SIDEBAR=XXXXXXXXXX
# ADSENSE_SLOT_IN_CONTENT=XXXXXXXXXX

# ── SMTP (recommended: AWS SES or Brevo) ──
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=CHANGE_ME
# SMTP_PASS=CHANGE_ME
